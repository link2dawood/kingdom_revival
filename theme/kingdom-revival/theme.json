{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "navy", "name": "Navy", "color": "#0C1C4F" },
				{ "slug": "navy-deep", "name": "Deep navy", "color": "#081030" },
				{ "slug": "red", "name": "Red", "color": "#D4070B" },
				{ "slug": "red-dark", "name": "Dark red", "color": "#B10609" },
				{ "slug": "orange", "name": "Orange", "color": "#F5A04A" },
				{ "slug": "ink", "name": "Ink", "color": "#141B33" },
				{ "slug": "muted", "name": "Muted", "color": "#5A6275" },
				{ "slug": "soft", "name": "Soft", "color": "#F4F6FB" },
				{ "slug": "line", "name": "Line", "color": "#E3E7F0" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"layout": {
			"contentSize": "740px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Figtree",
					"fontFamily": "Figtree, 'Segoe UI', Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Cormorant Garamond",
					"fontFamily": "'Cormorant Garamond', Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "scripture",
					"name": "Newsreader",
					"fontFamily": "Newsreader, Georgia, serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "14px" },
				{ "slug": "medium", "name": "Medium", "size": "17px" },
				{ "slug": "large", "name": "Large", "size": "clamp(22px, 2.4vw, 28px)" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(30px, 3.4vw, 42px)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--navy)" },
				"typography": { "lineHeight": "1.15" }
			}
		}
	}
}
